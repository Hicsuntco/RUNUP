        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda en tu historial, pero ya no se propondrá por defecto en tus próximas carreras."
          }
        }
      }
    },
    "Elles restent sur ton téléphone, rien n'est perdu — nouvelle tentative automatique bientôt.": {
