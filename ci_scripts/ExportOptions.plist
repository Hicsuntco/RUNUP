<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Comment `xcodebuild -exportArchive` doit signer et emballer l'archive produite par le
	     workflow GitHub Actions. Les mêmes réglages qu'Xcode écrirait si l'on faisait
	     « Distribute App → App Store Connect » à la main, mais versionnés : ce que la CI produit
	     ne dépend donc plus des cases cochées ce jour-là dans une fenêtre. -->

	<!-- « app-store » et non « app-store-connect » : les deux valeurs désignent la même
	     distribution, mais la seconde n'existe qu'à partir de Xcode 15.4. Celle-ci est acceptée
	     par toutes les versions, au prix d'un avertissement de dépréciation sur Xcode 16 — un
	     avertissement dans un log coûte moins cher qu'une construction qui échoue le jour où
	     GitHub change l'image de ses machines. -->
	<key>method</key>
	<string>app-store</string>

	<key>teamID</key>
	<string>SW49TQ25NV</string>

	<!-- Les trois cibles sont en CODE_SIGN_STYLE: Automatic dans `project.yml`. On garde le même
	     mode ici, et `-allowProvisioningUpdates` (passé par le workflow, avec la clé d'API App
	     Store Connect) laisse Xcode créer et télécharger lui-même les profils des trois bundle
	     IDs. L'alternative — exporter trois profils à la main et les stocker en secrets — se
	     casse silencieusement à chaque expiration annuelle. -->
	<key>signingStyle</key>
	<string>automatic</string>

	<!-- Envoie les fichiers de symboles : sans eux, les rapports de plantage remontés par
	     TestFlight sont des adresses mémoire au lieu de noms de fonctions. -->
	<key>uploadSymbols</key>
	<true/>

	<!-- LE RÉGLAGE QUI COMPTE. À `true` (le défaut), Xcode s'autorise à réécrire la version et le
	     numéro de build au moment de l'export. Le numéro calculé par le workflow, appliqué aux
	     trois cibles d'un seul coup par `prepare_project.sh`, ne serait alors plus celui reçu par
	     App Store Connect — et le lien entre un build TestFlight et le commit qui l'a produit
	     serait rompu. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
