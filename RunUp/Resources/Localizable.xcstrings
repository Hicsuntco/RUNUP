    "%lld semaines en 3 phases, calées sur ta date de course. Le plan s'ajuste chaque semaine selon ta forme — pas séance par séance.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld weeks in 3 phases, built around your race date. The plan adapts each week to how you're feeling — not session by session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld semanas en 3 fases, ajustadas a la fecha de tu carrera. El plan se adapta cada semana a tu forma — no sesión por sesión."
          }
        }
      }
    },
