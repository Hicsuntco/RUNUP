{
  "sourceLanguage": "fr",
  "strings": {
    "NSHealthShareUsageDescription": {
      "comment": "Dialogue système à la connexion d'Apple Santé.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp reads your Health data (heart rate, step count, active calories, sleep) to gauge how today is going, adapt your plan and track your daily goals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp lee tus datos de Salud (frecuencia cardíaca, pasos, calorías activas, sueño) para calcular tu forma del día, adaptar tu programa y seguir tus objetivos diarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp lit tes données Santé (fréquence cardiaque, nombre de pas, calories actives, sommeil) pour calculer ta forme du jour, adapter ton programme et suivre tes objectifs quotidiens."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "comment": "Dialogue système à la connexion d'Apple Santé (écriture).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp saves your runs to Health after each session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp guarda tus carreras en Salud después de cada sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp enregistre tes séances de course dans Santé après chaque sortie."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Dialogue système au premier démarrage d'une course.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp uses your location to track your distance, pace and route while you run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp usa tu ubicación para medir tu distancia, tu ritmo y tu recorrido mientras corres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp utilise ta position pour suivre ta distance, ton allure et ton tracé pendant une course."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Dialogue système au premier appui sur le micro du coach vocal.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp uses the microphone to hear you when you ask your coach a question out loud during a run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp usa el micrófono para escucharte cuando le haces una pregunta en voz alta a tu entrenador durante una carrera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp utilise le micro pour t'écouter quand tu poses une question à voix haute à ton coach pendant une course."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Dialogue système au premier appui sur le micro du coach vocal.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp transcribes what you say so your coach can answer you out loud while you run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp transcribe lo que dices para que tu entrenador pueda responderte en voz alta mientras corres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp transcrit ce que tu dis pour que ton coach puisse te répondre à voix haute pendant une course."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp checks your contacts against existing accounts to tell you who already uses the app. Addresses are turned into unreadable fingerprints on your phone before they are sent — your address book never leaves it, and nothing is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RunUp compara tus contactos con las cuentas existentes para decirte quién ya usa la app. Las direcciones se convierten en huellas ilegibles en tu teléfono antes de enviarse — tu agenda nunca sale de él, y no se conserva nada."
          }
        }
      }
    }
  },
  "version": "1.0"
}
